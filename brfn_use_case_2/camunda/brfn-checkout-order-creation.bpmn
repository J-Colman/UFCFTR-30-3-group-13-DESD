<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_BRFN_Checkout"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.29.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.6.0">

  <bpmn:collaboration id="Collaboration_BRFN">
    <bpmn:participant id="Participant_Checkout" name="BRFN CHECKOUT AND ORDER CREATION" processRef="brfn-checkout-order-creation" />
    <bpmn:participant id="Participant_CatalogueService" name="catalogue, inventory and order service" />
    <bpmn:messageFlow id="MessageFlow_StockQuery" name="Stock query" sourceRef="Task_CheckStock" targetRef="Participant_CatalogueService" />
    <bpmn:messageFlow id="MessageFlow_ProducerData" name="Producer data" sourceRef="Task_GroupByProducer" targetRef="Participant_CatalogueService" />
    <bpmn:messageFlow id="MessageFlow_Reserve" name="Reserve" sourceRef="Task_ReserveStock" targetRef="Participant_CatalogueService" />
    <bpmn:messageFlow id="MessageFlow_Release" name="release" sourceRef="Task_ReleaseStock" targetRef="Participant_CatalogueService" />
  </bpmn:collaboration>

  <bpmn:error id="Error_StockChanged" name="Stock changed" errorCode="STOCK_CHANGED" />

  <bpmn:process id="brfn-checkout-order-creation" name="BRFN Checkout and Order Creation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Checkout">
      <bpmn:lane id="Lane_Customer" name="CUSTOMER">
        <bpmn:flowNodeRef>Task_AmendBasket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_AmendBasket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BasketExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CheckoutAbandonedByCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CheckoutExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CancelledByCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketplace" name="MARKETPLACE PLATFORM">
        <bpmn:flowNodeRef>Start_CheckoutRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeBasket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BasketAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BasketEmpty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GroupByProducer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideDeliveryOptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOrderReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReserveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_StockChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PaymentFulfilment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyNotCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderNotPlaced</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ===== Start and basket loop ===== -->
    <bpmn:startEvent id="Start_CheckoutRequested" name="checkout requested">
      <bpmn:outgoing>Flow_Start_Merge</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_MergeBasket">
      <bpmn:incoming>Flow_Start_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_BasketUpdated</bpmn:incoming>
      <bpmn:incoming>Flow_StockChanged</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_CheckStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CheckStock" name="check stock availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-check-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_CheckStock</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckStock_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_BasketAvailable" name="Basket available?">
      <bpmn:incoming>Flow_CheckStock_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AllAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_ItemsUnavailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_BasketEmpty</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_BasketEmpty" name="Checkout abandoned">
      <bpmn:incoming>Flow_BasketEmpty</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_AmendBasket" name="Amend basket">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="brfn-amend-basket" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ItemsUnavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Amend_Decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Timer_AmendBasket" name="30 min" attachedToRef="Task_AmendBasket">
      <bpmn:outgoing>Flow_BasketTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_AmendBasket">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End_BasketExpired" name="Basket expired">
      <bpmn:incoming>Flow_BasketTimeout</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_CustomerDecision" name="Customer decision?" default="Flow_CustomerCancel">
      <bpmn:incoming>Flow_Amend_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerCancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_BasketUpdated</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_CheckoutAbandonedByCustomer" name="Checkout abandoned">
      <bpmn:incoming>Flow_CustomerCancel</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== Grouping, DMN and review ===== -->
    <bpmn:serviceTask id="Task_GroupByProducer" name="Group by producer and food miles">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-group-by-producer" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AllAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Group_Decide</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_DecideDeliveryOptions" name="Decide delivery options">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="brfn-fulfilment-options" resultVariable="producerOptions" />
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="producerOptions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Group_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_Prepare</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerGroups" inputElement="producerGroup" outputCollection="fulfilmentOptionsByProducer" outputElement="={producerId: producerGroup.producerId, producerName: producerGroup.producerName, subtotal: producerGroup.subtotal, options: producerOptions}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_PrepareOrderReview" name="Prepare order review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-prepare-order-review" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decide_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Review</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ReviewOrder" name="Review order and choose fulfilment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="brfn-review-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Prepare_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Timer_ReviewOrder" name="30 min" attachedToRef="Task_ReviewOrder">
      <bpmn:outgoing>Flow_ReviewTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_ReviewOrder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End_CheckoutExpired" name="Checkout expired">
      <bpmn:incoming>Flow_ReviewTimeout</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_OrderConfirmed" name="Order confirmed?" default="Flow_OrderCancel">
      <bpmn:incoming>Flow_Review_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderCancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderConfirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_CancelledByCustomer" name="Cancelled by customer">
      <bpmn:incoming>Flow_OrderCancel</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== Reservation, order, payment ===== -->
    <bpmn:serviceTask id="Task_ReserveStock" name="Reserve stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-reserve-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Create</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_StockChanged" name="Stock changed" attachedToRef="Task_ReserveStock">
      <bpmn:outgoing>Flow_StockChanged</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_StockChanged" errorRef="Error_StockChanged" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_CreateOrder" name="Create order and split by producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-create-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reserve_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Payment</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="Activity_PaymentFulfilment" name="Payment and Fulfilment">
      <bpmn:incoming>Flow_Create_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Gateway</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start" name="Order created">
        <bpmn:outgoing>Sub_Flow_Start_Pay</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Sub_Task_TakePayment" name="Take payment">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-take-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Sub_Flow_Start_Pay</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Pay_Gateway</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Sub_Gateway_PaymentOk" name="Payment successful?" default="Sub_Flow_PaymentFailed">
        <bpmn:incoming>Sub_Flow_Pay_Gateway</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_PaymentOk</bpmn:outgoing>
        <bpmn:outgoing>Sub_Flow_PaymentFailed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Sub_Task_ConfirmProducers" name="Confirm producer orders and schedule fulfilment">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="brfn-confirm-producer-orders" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Sub_Flow_PaymentOk</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Confirm_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Sub_End_Fulfilled" name="Order fulfilment scheduled">
        <bpmn:incoming>Sub_Flow_Confirm_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Sub_End_PaymentFailed" name="Payment failed">
        <bpmn:incoming>Sub_Flow_PaymentFailed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Flow_Start_Pay" sourceRef="Sub_Start" targetRef="Sub_Task_TakePayment" />
      <bpmn:sequenceFlow id="Sub_Flow_Pay_Gateway" sourceRef="Sub_Task_TakePayment" targetRef="Sub_Gateway_PaymentOk" />
      <bpmn:sequenceFlow id="Sub_Flow_PaymentOk" name="yes" sourceRef="Sub_Gateway_PaymentOk" targetRef="Sub_Task_ConfirmProducers">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "PAID"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sub_Flow_PaymentFailed" name="no" sourceRef="Sub_Gateway_PaymentOk" targetRef="Sub_End_PaymentFailed" />
      <bpmn:sequenceFlow id="Sub_Flow_Confirm_End" sourceRef="Sub_Task_ConfirmProducers" targetRef="Sub_End_Fulfilled" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_OrderCompleted" name="Order completed?" default="Flow_OrderNotCompleted">
      <bpmn:incoming>Flow_Payment_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderCompletedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderNotCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_OrderPlaced" name="Order placed and confirmed">
      <bpmn:incoming>Flow_OrderCompletedYes</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_ReleaseStock" name="Release stock and cancel order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-release-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderNotCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_Release_Notify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifyNotCompleted" name="Notify customer (not completed)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="brfn-notify-customer" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Release_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_OrderNotPlaced" name="Order not placed">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:textAnnotation id="Annotation_DMN">
      <bpmn:text>DMN "Fulfilment options" evaluated once per producer (parallel multi-instance). lead time &gt;= 48 h</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_DMN" associationDirection="None" sourceRef="Task_DecideDeliveryOptions" targetRef="Annotation_DMN" />

    <!-- ===== Sequence flows ===== -->
    <bpmn:sequenceFlow id="Flow_Start_Merge" sourceRef="Start_CheckoutRequested" targetRef="Gateway_MergeBasket" />
    <bpmn:sequenceFlow id="Flow_Merge_CheckStock" sourceRef="Gateway_MergeBasket" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="Flow_CheckStock_Gateway" sourceRef="Task_CheckStock" targetRef="Gateway_BasketAvailable" />
    <bpmn:sequenceFlow id="Flow_AllAvailable" name="All available" sourceRef="Gateway_BasketAvailable" targetRef="Task_GroupByProducer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "ALL_AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ItemsUnavailable" name="Items unavailable" sourceRef="Gateway_BasketAvailable" targetRef="Task_AmendBasket">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "PARTIAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BasketEmpty" name="Basket empty" sourceRef="Gateway_BasketAvailable" targetRef="End_BasketEmpty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "EMPTY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Amend_Decision" sourceRef="Task_AmendBasket" targetRef="Gateway_CustomerDecision" />
    <bpmn:sequenceFlow id="Flow_BasketTimeout" name="Duration" sourceRef="Timer_AmendBasket" targetRef="End_BasketExpired" />
    <bpmn:sequenceFlow id="Flow_CustomerCancel" name="cancel" sourceRef="Gateway_CustomerDecision" targetRef="End_CheckoutAbandonedByCustomer" />
    <bpmn:sequenceFlow id="Flow_BasketUpdated" name="Basket updated" sourceRef="Gateway_CustomerDecision" targetRef="Gateway_MergeBasket">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=customerDecision = "update"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Group_Decide" sourceRef="Task_GroupByProducer" targetRef="Task_DecideDeliveryOptions" />
    <bpmn:sequenceFlow id="Flow_Decide_Prepare" sourceRef="Task_DecideDeliveryOptions" targetRef="Task_PrepareOrderReview" />
    <bpmn:sequenceFlow id="Flow_Prepare_Review" sourceRef="Task_PrepareOrderReview" targetRef="Task_ReviewOrder" />
    <bpmn:sequenceFlow id="Flow_ReviewTimeout" sourceRef="Timer_ReviewOrder" targetRef="End_CheckoutExpired" />
    <bpmn:sequenceFlow id="Flow_Review_Gateway" sourceRef="Task_ReviewOrder" targetRef="Gateway_OrderConfirmed" />
    <bpmn:sequenceFlow id="Flow_OrderCancel" name="Cancel" sourceRef="Gateway_OrderConfirmed" targetRef="End_CancelledByCustomer" />
    <bpmn:sequenceFlow id="Flow_OrderConfirm" name="Confirm" sourceRef="Gateway_OrderConfirmed" targetRef="Task_ReserveStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderDecision = "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StockChanged" sourceRef="Boundary_StockChanged" targetRef="Gateway_MergeBasket" />
    <bpmn:sequenceFlow id="Flow_Reserve_Create" sourceRef="Task_ReserveStock" targetRef="Task_CreateOrder" />
    <bpmn:sequenceFlow id="Flow_Create_Payment" sourceRef="Task_CreateOrder" targetRef="Activity_PaymentFulfilment" />
    <bpmn:sequenceFlow id="Flow_Payment_Gateway" sourceRef="Activity_PaymentFulfilment" targetRef="Gateway_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_OrderCompletedYes" name="yes" sourceRef="Gateway_OrderCompleted" targetRef="End_OrderPlaced">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderCompleted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OrderNotCompleted" name="no" sourceRef="Gateway_OrderCompleted" targetRef="Task_ReleaseStock" />
    <bpmn:sequenceFlow id="Flow_Release_Notify" sourceRef="Task_ReleaseStock" targetRef="Task_NotifyNotCompleted" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Task_NotifyNotCompleted" targetRef="End_OrderNotPlaced" />
  </bpmn:process>

  <!-- ================= Diagram: main collaboration ================= -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Collaboration_BRFN">
      <bpmndi:BPMNShape id="Participant_Checkout_di" bpmnElement="Participant_Checkout" isHorizontal="true">
        <dc:Bounds x="5" y="5" width="2565" height="767" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="35" y="5" width="2535" height="426" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Marketplace_di" bpmnElement="Lane_Marketplace" isHorizontal="true">
        <dc:Bounds x="35" y="431" width="2535" height="341" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_CatalogueService_di" bpmnElement="Participant_CatalogueService" isHorizontal="true">
        <dc:Bounds x="5" y="857" width="2565" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_CheckoutRequested_di" bpmnElement="Start_CheckoutRequested">
        <dc:Bounds x="101" y="547" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="85" y="590" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeBasket_di" bpmnElement="Gateway_MergeBasket" isMarkerVisible="true">
        <dc:Bounds x="240" y="540" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckStock_di" bpmnElement="Task_CheckStock">
        <dc:Bounds x="376" y="516" width="121" height="97" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_BasketAvailable_di" bpmnElement="Gateway_BasketAvailable" isMarkerVisible="true">
        <dc:Bounds x="606" y="540" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="515" width="65" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BasketEmpty_di" bpmnElement="End_BasketEmpty">
        <dc:Bounds x="613" y="658" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="658" y="668" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AmendBasket_di" bpmnElement="Task_AmendBasket">
        <dc:Bounds x="570" y="260" width="122" height="97" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BasketExpired_di" bpmnElement="End_BasketExpired">
        <dc:Bounds x="760" y="143" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="812" y="154" width="74" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CustomerDecision_di" bpmnElement="Gateway_CustomerDecision" isMarkerVisible="true">
        <dc:Bounds x="765" y="283" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="795" y="338" width="62" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CheckoutAbandonedByCustomer_di" bpmnElement="End_CheckoutAbandonedByCustomer">
        <dc:Bounds x="942" y="291" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="926" y="334" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
