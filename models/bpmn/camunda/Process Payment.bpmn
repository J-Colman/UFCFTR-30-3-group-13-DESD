    <bpmn:sequenceFlow id="Flow_1dg7ypi" sourceRef="gateway_02" targetRef="too_many_declines_gateway" />
    <bpmn:sequenceFlow id="Flow_1q0t8oa" name="Yes" sourceRef="retry_gateway" targetRef="gateway_01">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentDecision = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0vc2z2b" sourceRef="timer_01" targetRef="gateway_01" />
    <bpmn:sequenceFlow id="Flow_0rpsd72" sourceRef="StartEvent_1" targetRef="gateway_01" />
