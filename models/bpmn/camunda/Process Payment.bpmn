      <bpmn:timerEventDefinition id="TimerEventDefinition_11y6bdx">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="service_down_process" name="Service down" attachedToRef="submit_payment">
