    <bpmn:sequenceFlow id="Flow_1v3b9z7" sourceRef="submit_payment" targetRef="approved_gateway" />
    <bpmn:sequenceFlow id="Flow_0e8pl0n" name="Yes" sourceRef="approved_gateway" targetRef="paid_end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_116tz4z" sourceRef="service_down_process" targetRef="count_retry" />
    <bpmn:sequenceFlow id="Flow_0m57zqm" sourceRef="count_retry" targetRef="Gateway_03gyacn" />
    <bpmn:sequenceFlow id="Flow_0ygcon8" name="No" sourceRef="Gateway_03gyacn" targetRef="set_unavailable_message">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryCount &gt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1bbrhsc" name="Yes" sourceRef="Gateway_03gyacn" targetRef="timer_01" />
    <bpmn:sequenceFlow id="Flow_1y4gxpk" name="No" sourceRef="too_many_declines_gateway" targetRef="retry_or_cancel" />
    <bpmn:sequenceFlow id="Flow_0x0x5gx" sourceRef="retry_or_cancel" targetRef="retry_gateway" />
    <bpmn:sequenceFlow id="Flow_1ijmri5" name="Yes" sourceRef="too_many_declines_gateway" targetRef="too_many_declines_end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=declineCount &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0tn3fw3" sourceRef="timer_02" targetRef="form_expired_end" />
    <bpmn:sequenceFlow id="Flow_0b7d2cp" name="No" sourceRef="retry_gateway" targetRef="payment_failed_end" />
  </bpmn:process>
