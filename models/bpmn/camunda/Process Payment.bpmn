    <bpmn:endEvent id="paid_end" name="Paid">
      <bpmn:incoming>Flow_0e8pl0n</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="submit_payment" name="Submit Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="submit-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19dzce2</bpmn:incoming>
      <bpmn:outgoing>Flow_1v3b9z7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="count_retry" name="Count Retry">
      <bpmn:extensionElements>
        <zeebe:script expression="=(if retryCount = null then 0 else retryCount) + 1" resultVariable="retryCount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_116tz4z</bpmn:incoming>
      <bpmn:outgoing>Flow_0m57zqm</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_03gyacn" name="Retries left?" default="Flow_1bbrhsc">
      <bpmn:incoming>Flow_0m57zqm</bpmn:incoming>
      <bpmn:outgoing>Flow_1bbrhsc</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ygcon8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="timer_01" name="Wait 1 min">
      <bpmn:incoming>Flow_1bbrhsc</bpmn:incoming>
      <bpmn:outgoing>Flow_0vc2z2b</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1qana6e">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="set_unavailable_message" name="Set Unavailable Message">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;The payment service is unavailable. Please try again later.&#34;" resultVariable="paymentFailureReason" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ygcon8</bpmn:incoming>
      <bpmn:outgoing>Flow_18z89pl</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="retry_or_cancel" name="Retry or Cancel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_0ytiovc" />
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="retryCount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1y4gxpk</bpmn:incoming>
      <bpmn:outgoing>Flow_0x0x5gx</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="too_many_declines_gateway" name="Too many declines?" default="Flow_1y4gxpk">
