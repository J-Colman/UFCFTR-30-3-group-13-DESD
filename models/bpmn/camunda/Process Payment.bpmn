    <bpmn:exclusiveGateway id="approved_gateway" name="Approved?" default="Flow_17z6b1e">
      <bpmn:incoming>Flow_1v3b9z7</bpmn:incoming>
      <bpmn:outgoing>Flow_0e8pl0n</bpmn:outgoing>
