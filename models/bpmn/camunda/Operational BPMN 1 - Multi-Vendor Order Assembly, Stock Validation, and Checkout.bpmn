    <bpmn:sequenceFlow id="Flow_1fn8g5y" sourceRef="Event_13c2b9a" targetRef="checkout_expired_03" />
    <bpmn:sequenceFlow id="Flow_0h9pxlw" sourceRef="prepare_order_summary" targetRef="review_order" />
    <bpmn:sequenceFlow id="Flow_1785i7k" sourceRef="Activity_1iyd4cz" targetRef="Gateway_093bze2" />
    <bpmn:sequenceFlow id="Flow_1kaf8iw" name="Basket empty" sourceRef="stock_available_gateway" targetRef="basket_empty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "EMPTY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11nxc94" sourceRef="auth_failed_process" targetRef="auth_failed" />
    <bpmn:sequenceFlow id="Flow_1qplrib" name="No" sourceRef="logged_in_gateway" targetRef="authenticate_customer" />
    <bpmn:sequenceFlow id="Flow_1usb9so" name="Authenticated" sourceRef="authenticate_customer" targetRef="gateway_02" />
    <bpmn:sequenceFlow id="Flow_1sfb55y" name="Yes" sourceRef="logged_in_gateway" targetRef="gateway_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loggedIn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16wbtgk" name="Items unavailable" sourceRef="stock_available_gateway" targetRef="Activity_1iyd4cz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "PARTIAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0rti79t" sourceRef="gateway_02" targetRef="check_stock_quantity_availability" />
    <bpmn:sequenceFlow id="Flow_0dasdq3" sourceRef="check_stock_quantity_availability" targetRef="stock_available_gateway" />
    <bpmn:sequenceFlow id="Flow_1s8hpqq" name="All available" sourceRef="stock_available_gateway" targetRef="identify_producers" />
    <bpmn:sequenceFlow id="Flow_07z8qgy" sourceRef="reserve_stock" targetRef="create_order" />
    <bpmn:sequenceFlow id="Flow_06q6cmw" sourceRef="create_order" targetRef="split_by_producer" />
    <bpmn:sequenceFlow id="Flow_1pw15fq" sourceRef="split_by_producer" targetRef="order_ready_for_payment_process_f1" />
