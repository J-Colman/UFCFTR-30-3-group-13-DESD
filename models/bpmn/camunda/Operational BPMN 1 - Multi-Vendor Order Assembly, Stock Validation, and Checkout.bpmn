      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nextStep = "shop"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_182n8nf" sourceRef="browse_products" targetRef="add_to_basket" />
    <bpmn:sequenceFlow id="Flow_1yx44kf" sourceRef="gateway_01" targetRef="browse_products" />
    <bpmn:sequenceFlow id="Flow_0mhrmdm" sourceRef="timer_01" targetRef="checkout_expired_end" />
    <bpmn:sequenceFlow id="Flow_0ki7nfc" sourceRef="Gateway_093bze2" targetRef="amend_basket" />
    <bpmn:sequenceFlow id="Flow_00jy9sc" sourceRef="amend_basket" targetRef="continue_gateway" />
    <bpmn:sequenceFlow id="Flow_18mmmzj" name="No" sourceRef="continue_gateway" targetRef="cancelled_01" />
    <bpmn:sequenceFlow id="Flow_00wkmpb" name="Yes" sourceRef="continue_gateway" targetRef="gateway_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=basketDecision = "continue"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0uao82x" sourceRef="proceed_to_checkout" targetRef="logged_in_gateway" />
    <bpmn:sequenceFlow id="Flow_0l5qrp7" sourceRef="stock_recheck_process" targetRef="gateway_03" />
