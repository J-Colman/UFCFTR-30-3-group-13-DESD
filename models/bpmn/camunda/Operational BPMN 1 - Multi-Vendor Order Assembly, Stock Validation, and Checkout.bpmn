    <bpmn:sequenceFlow id="Flow_0ursiep" sourceRef="review_order" targetRef="customer_decision_gateway" />
    <bpmn:sequenceFlow id="Flow_01m3rd1" name="Confirm" sourceRef="customer_decision_gateway" targetRef="reserve_stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0gxtwo8" name="Cancel" sourceRef="customer_decision_gateway" targetRef="cancelled_02" />
    <bpmn:sequenceFlow id="Flow_0gwz41s" name="Amend" sourceRef="customer_decision_gateway" targetRef="Gateway_093bze2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "amend"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_034fgsi" sourceRef="add_to_basket" targetRef="keep_shopping_gateway" />
    <bpmn:sequenceFlow id="Flow_1p40wok" name="No" sourceRef="keep_shopping_gateway" targetRef="proceed_to_checkout" />
