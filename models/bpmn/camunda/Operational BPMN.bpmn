    <bpmn:sequenceFlow id="Flow_0ursiep" sourceRef="review_order" targetRef="gateway_06" />
    <bpmn:sequenceFlow id="Flow_01m3rd1" name="Confirm" sourceRef="gateway_06" targetRef="reserve_stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "confirm"</bpmn:conditionExpression>
