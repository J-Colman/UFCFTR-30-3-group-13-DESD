      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "amend"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_034fgsi" sourceRef="add_to_basket" targetRef="keep_shopping" />
    <bpmn:sequenceFlow id="Flow_1p40wok" name="No" sourceRef="keep_shopping" targetRef="proceed_to_checkout" />
    <bpmn:sequenceFlow id="Flow_0ozfbpp" name="Yes" sourceRef="keep_shopping" targetRef="gateway_01">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nextStep = "shop"</bpmn:conditionExpression>
