    <bpmn:sequenceFlow id="Flow_18mmmzj" name="No" sourceRef="gateway_05" targetRef="cancelled_basket" />
    <bpmn:sequenceFlow id="Flow_00wkmpb" name="Yes" sourceRef="gateway_05" targetRef="gateway_07">
