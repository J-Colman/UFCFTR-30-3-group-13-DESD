<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="4c2418b" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="f1-checkout">
    <bpmn:participant id="participant-f1-checkout" name="Operational BPMN 1 - Multi-Vendor Order Assembly, Stock Validation, and Checkout" processRef="process-f1-checkout" />
    <bpmn:participant id="participant-f2-payment" name="Payment (F2)" />
    <bpmn:messageFlow id="flow-end-msg-order-ready-for-payment" sourceRef="end-msg-order-ready-for-payment" targetRef="participant-f2-payment" />
  </bpmn:collaboration>
  <bpmn:process id="process-f1-checkout" name="Operational BPMN 1 - Multi-Vendor Order Assembly, Stock Validation, and Checkout" isExecutable="true">
    <bpmn:laneSet id="LaneSet_17w0u8d">
      <bpmn:lane id="lane-marketplace-platform" name="Marketplace Platform">
        <bpmn:flowNodeRef>end-basket-empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-auth-fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>auth-customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-logged-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show-unavailable-items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-merge-check-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-stock-available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve-stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split-by-producer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>identify-producers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>determine-delivery-options</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare-order-summary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-msg-order-ready-for-payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>err-stock-unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>err-auth-fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-customer" name="Customer">
        <bpmn:flowNodeRef>gw-customer-decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-keep-shopping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add-to-basket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>browse-products</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-checkout-expired-1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>amend-basket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proceed-to-checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-merge-continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-cancel-2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-checkout-expired-3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review-order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-merge-amend-basket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-cancel-1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choose-delivery-option</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end-checkout-expired-2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start-visit-site</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw-merge-browse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer-2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer-3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer-1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="gw-customer-decision" name="Customer decision?" default="flow-customer-decision-cancel">
      <bpmn:incoming>flow-review-order</bpmn:incoming>
      <bpmn:outgoing>flow-customer-decision-confirm</bpmn:outgoing>
      <bpmn:outgoing>flow-customer-decision-cancel</bpmn:outgoing>
      <bpmn:outgoing>flow-customer-decision-amend</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw-keep-shopping" name="Keep Shopping?" default="flow-keep-shopping-no">
      <bpmn:incoming>flow-add-to-basket</bpmn:incoming>
      <bpmn:outgoing>flow-keep-shopping-no</bpmn:outgoing>
      <bpmn:outgoing>flow-keep-shopping-yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="add-to-basket" name="Add to basket">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-add-to-basket" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-browse-products</bpmn:incoming>
      <bpmn:outgoing>flow-add-to-basket</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="browse-products" name="Browse Products">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-browse-products" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-cont-1</bpmn:incoming>
      <bpmn:outgoing>flow-browse-products</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end-checkout-expired-1" name="Checkout expired">
      <bpmn:incoming>flow-timer-1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="amend-basket" name="Amend Basket">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-amend-basket" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-cont-3</bpmn:incoming>
      <bpmn:outgoing>flow-amend-basket</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw-continue" name="Continue?" default="flow-continue-no">
      <bpmn:incoming>flow-amend-basket</bpmn:incoming>
      <bpmn:outgoing>flow-continue-no</bpmn:outgoing>
      <bpmn:outgoing>flow-continue-yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="proceed-to-checkout" name="Proceed to Checkout">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-proceed-to-checkout" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-keep-shopping-no</bpmn:incoming>
      <bpmn:outgoing>flow-proceed-to-checkout</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw-merge-continue">
      <bpmn:incoming>flow-continue-yes</bpmn:incoming>
      <bpmn:incoming>flow-stock-unavailable</bpmn:incoming>
      <bpmn:outgoing>flow-cont-4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end-cancel-2" name="Cancelled">
      <bpmn:incoming>flow-customer-decision-cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end-checkout-expired-3" name="Checkout expired">
      <bpmn:incoming>flow-timer-3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="review-order" name="Review Order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-review-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-prepare-order-summary</bpmn:incoming>
      <bpmn:outgoing>flow-review-order</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw-merge-amend-basket">
      <bpmn:incoming>flow-customer-decision-amend</bpmn:incoming>
      <bpmn:incoming>flow-show-unavailable-items</bpmn:incoming>
      <bpmn:outgoing>flow-cont-3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end-basket-empty" name="Basket Empty">
      <bpmn:incoming>flow-stock-available-no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end-auth-fail" name="Authentication failed">
      <bpmn:incoming>auth-fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="auth-customer" name="Authenticate Customer">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="process-auth-customer" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-logged-in-no</bpmn:incoming>
      <bpmn:outgoing>flow-auth-success</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-logged-in" name="Logged in?" default="flow-logged-in-no">
      <bpmn:incoming>flow-proceed-to-checkout</bpmn:incoming>
      <bpmn:outgoing>flow-logged-in-no</bpmn:outgoing>
      <bpmn:outgoing>flow-logged-in-yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="show-unavailable-items" name="Show Unavailable Items">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-show-unavailable-items" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-stock-available-partial</bpmn:incoming>
      <bpmn:outgoing>flow-show-unavailable-items</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw-merge-check-stock">
      <bpmn:incoming>flow-cont-4</bpmn:incoming>
      <bpmn:incoming>flow-auth-success</bpmn:incoming>
      <bpmn:incoming>flow-logged-in-yes</bpmn:incoming>
      <bpmn:outgoing>flow-cont-2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="check-stock" name="Check Stock and Quantity Availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-check-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-cont-2</bpmn:incoming>
      <bpmn:outgoing>flow-check-stock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw-stock-available" name="Stock Available?" default="flow-stock-available-yes">
      <bpmn:incoming>flow-check-stock</bpmn:incoming>
      <bpmn:outgoing>flow-stock-available-no</bpmn:outgoing>
      <bpmn:outgoing>flow-stock-available-partial</bpmn:outgoing>
      <bpmn:outgoing>flow-stock-available-yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reserve-stock" name="Reserve Stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-reserve-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-customer-decision-confirm</bpmn:incoming>
      <bpmn:outgoing>flow-reserve-stock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="create-order" name="Create Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-create-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-reserve-stock</bpmn:incoming>
      <bpmn:outgoing>flow-create-order</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="split-by-producer" name="Split by Producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-split-by-producer" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-create-order</bpmn:incoming>
      <bpmn:outgoing>flow-split-by-producer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="identify-producers" name="Identify Producers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-identify-producers" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-stock-available-yes</bpmn:incoming>
      <bpmn:outgoing>flow-identify-producers</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="determine-delivery-options" name="Determine Delivery Options">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="delivery-options" resultVariable="deliveryOption" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-identify-producers</bpmn:incoming>
      <bpmn:outgoing>flow-determine-delivery-options</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producers" inputElement="producer" outputCollection="deliveryOptions" outputElement="=deliveryOption" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="prepare-order-summary" name="Prepare Order Summary">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-prepare-order-summary" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-choose-delivery-option</bpmn:incoming>
      <bpmn:outgoing>flow-prepare-order-summary</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end-cancel-1" name="Cancelled">
      <bpmn:incoming>flow-continue-no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="choose-delivery-option" name="Choose Delivery Option">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-choose-delivery-option" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow-determine-delivery-options</bpmn:incoming>
      <bpmn:outgoing>flow-choose-delivery-option</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end-checkout-expired-2" name="Checkout expired">
      <bpmn:incoming>flow-timer-2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start-visit-site" name="Visits site">
      <bpmn:outgoing>flow-visit-site</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw-merge-browse">
      <bpmn:incoming>flow-keep-shopping-yes</bpmn:incoming>
      <bpmn:incoming>flow-visit-site</bpmn:incoming>
      <bpmn:outgoing>flow-cont-1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end-msg-order-ready-for-payment" name="Order ready for payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="job-publish-order-ready" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="OrderReadyForPayment" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-split-by-producer</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_09dafl0" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="timer-2" name="30 mins" attachedToRef="choose-delivery-option">
      <bpmn:outgoing>flow-timer-2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1y5k9qw">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="err-stock-unavailable" name="Stock changed, re-check" attachedToRef="reserve-stock">
      <bpmn:outgoing>flow-stock-unavailable</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1l9lfyc" errorRef="Error_1cfac5g" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="err-auth-fail" name="Auth Failed" attachedToRef="auth-customer">
      <bpmn:outgoing>auth-fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_04stczt" errorRef="Error_0pnkihc" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="timer-3" name="30 mins" attachedToRef="review-order">
      <bpmn:outgoing>flow-timer-3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0vmwf3j">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="timer-1" name="30 mins" attachedToRef="amend-basket">
      <bpmn:outgoing>flow-timer-1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0f7r35m">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow-review-order" sourceRef="review-order" targetRef="gw-customer-decision" />
    <bpmn:sequenceFlow id="flow-customer-decision-confirm" name="Confirm" sourceRef="gw-customer-decision" targetRef="reserve-stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-customer-decision-cancel" name="Cancel" sourceRef="gw-customer-decision" targetRef="end-cancel-2" />
    <bpmn:sequenceFlow id="flow-customer-decision-amend" name="Amend" sourceRef="gw-customer-decision" targetRef="gw-merge-amend-basket">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "amend"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-add-to-basket" sourceRef="add-to-basket" targetRef="gw-keep-shopping" />
    <bpmn:sequenceFlow id="flow-keep-shopping-no" name="No" sourceRef="gw-keep-shopping" targetRef="proceed-to-checkout" />
    <bpmn:sequenceFlow id="flow-keep-shopping-yes" name="Yes" sourceRef="gw-keep-shopping" targetRef="gw-merge-browse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nextStep = "shop"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-browse-products" sourceRef="browse-products" targetRef="add-to-basket" />
    <bpmn:sequenceFlow id="flow-cont-1" sourceRef="gw-merge-browse" targetRef="browse-products" />
    <bpmn:sequenceFlow id="flow-timer-1" sourceRef="timer-1" targetRef="end-checkout-expired-1" />
    <bpmn:sequenceFlow id="flow-cont-3" sourceRef="gw-merge-amend-basket" targetRef="amend-basket" />
    <bpmn:sequenceFlow id="flow-amend-basket" sourceRef="amend-basket" targetRef="gw-continue" />
    <bpmn:sequenceFlow id="flow-continue-no" name="No" sourceRef="gw-continue" targetRef="end-cancel-1" />
    <bpmn:sequenceFlow id="flow-continue-yes" name="Yes" sourceRef="gw-continue" targetRef="gw-merge-continue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=basketDecision = "continue"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-proceed-to-checkout" sourceRef="proceed-to-checkout" targetRef="gw-logged-in" />
    <bpmn:sequenceFlow id="flow-stock-unavailable" sourceRef="err-stock-unavailable" targetRef="gw-merge-continue" />
    <bpmn:sequenceFlow id="flow-cont-4" sourceRef="gw-merge-continue" targetRef="gw-merge-check-stock" />
    <bpmn:sequenceFlow id="flow-timer-3" sourceRef="timer-3" targetRef="end-checkout-expired-3" />
    <bpmn:sequenceFlow id="flow-prepare-order-summary" sourceRef="prepare-order-summary" targetRef="review-order" />
    <bpmn:sequenceFlow id="flow-show-unavailable-items" sourceRef="show-unavailable-items" targetRef="gw-merge-amend-basket" />
    <bpmn:sequenceFlow id="flow-stock-available-no" name="Basket empty" sourceRef="gw-stock-available" targetRef="end-basket-empty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "EMPTY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="auth-fail" sourceRef="err-auth-fail" targetRef="end-auth-fail" />
    <bpmn:sequenceFlow id="flow-logged-in-no" name="No" sourceRef="gw-logged-in" targetRef="auth-customer" />
    <bpmn:sequenceFlow id="flow-auth-success" name="Authenticated" sourceRef="auth-customer" targetRef="gw-merge-check-stock" />
    <bpmn:sequenceFlow id="flow-logged-in-yes" name="Yes" sourceRef="gw-logged-in" targetRef="gw-merge-check-stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loggedIn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-stock-available-partial" name="Items unavailable" sourceRef="gw-stock-available" targetRef="show-unavailable-items">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "PARTIAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-cont-2" sourceRef="gw-merge-check-stock" targetRef="check-stock" />
    <bpmn:sequenceFlow id="flow-check-stock" sourceRef="check-stock" targetRef="gw-stock-available" />
    <bpmn:sequenceFlow id="flow-stock-available-yes" name="All available" sourceRef="gw-stock-available" targetRef="identify-producers" />
    <bpmn:sequenceFlow id="flow-reserve-stock" sourceRef="reserve-stock" targetRef="create-order" />
    <bpmn:sequenceFlow id="flow-create-order" sourceRef="create-order" targetRef="split-by-producer" />
    <bpmn:sequenceFlow id="flow-split-by-producer" sourceRef="split-by-producer" targetRef="end-msg-order-ready-for-payment" />
    <bpmn:sequenceFlow id="flow-identify-producers" sourceRef="identify-producers" targetRef="determine-delivery-options" />
    <bpmn:sequenceFlow id="flow-determine-delivery-options" sourceRef="determine-delivery-options" targetRef="choose-delivery-option" />
    <bpmn:sequenceFlow id="flow-choose-delivery-option" sourceRef="choose-delivery-option" targetRef="prepare-order-summary" />
    <bpmn:sequenceFlow id="flow-timer-2" sourceRef="timer-2" targetRef="end-checkout-expired-2" />
    <bpmn:sequenceFlow id="flow-visit-site" sourceRef="start-visit-site" targetRef="gw-merge-browse" />
  </bpmn:process>
