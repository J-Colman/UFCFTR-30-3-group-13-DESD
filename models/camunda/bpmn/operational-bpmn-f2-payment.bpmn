    <bpmn:scriptTask id="count_retry" name="Count Retry">
      <bpmn:extensionElements>
        <zeebe:script expression="=(if retryCount = null then 0 else retryCount) + 1" resultVariable="retryCount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_116tz4z</bpmn:incoming>
      <bpmn:outgoing>Flow_0m57zqm</bpmn:outgoing>
    </bpmn:scriptTask>
