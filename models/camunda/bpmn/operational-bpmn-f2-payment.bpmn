    <bpmn:sendTask id="notify_producers" name="Notify Producers">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yyyu0m</bpmn:incoming>
      <bpmn:outgoing>Flow_177yt6w</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerSettlements" inputElement="settlement" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:sendTask>
    <bpmn:serviceTask id="update_inventory" name="Update Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0irjr6x</bpmn:incoming>
      <bpmn:outgoing>Flow_1cks5oc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="confirm_order_to_customer" name="Confirm Order to Customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="confirm-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n4rjl6</bpmn:incoming>
      <bpmn:outgoing>Flow_0dyx0lf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="record_commission" name="Record Commission">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-commission" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08wzdon</bpmn:incoming>
      <bpmn:outgoing>Flow_1y78d2l</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="order_ready_for_payment_process_f2" name="Order ready for payment">
      <bpmn:outgoing>Flow_0emku3e</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1m6otah" messageRef="Message_1o6ej37" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="calculate_producer_amounts_commission" name="Calculate Producer Amounts and Commission">
      <bpmn:extensionElements>
        <zeebe:script expression="={ &#10;  producer: producerOrder.producer,&#10;  total: producerOrder.total,&#10;  commission: producerOrder.total * 0.05,&#10;  producerAmount: producerOrder.total * 0.95&#10;}" resultVariable="settlement" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0emku3e</bpmn:incoming>
      <bpmn:outgoing>Flow_1c3u44u</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerOrders" inputElement="producerOrder" outputCollection="producerSettlements" outputElement="=settlement" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:scriptTask>
    <bpmn:userTask id="enter_payment_details" name="Enter Payment Details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enter-payment-details-0r9yxm2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1c3u44u</bpmn:incoming>
      <bpmn:outgoing>Flow_0bepvyz</bpmn:outgoing>
    </bpmn:userTask>
