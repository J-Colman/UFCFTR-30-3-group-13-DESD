  <decision id="delivery-options" name="Delivery Options">
    <decisionTable id="DecisionTable_0un0jiq" hitPolicy="COLLECT">
      <input id="InputClause_1y940ln" label="Offers Delivery?">
        <inputExpression id="LiteralExpression_17lfhxc" typeRef="boolean">
          <text>producer.offersDelivery</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Option" name="option" typeRef="string" />
      <rule id="DecisionRule_086gekx">
        <inputEntry id="UnaryTests_07bt7kb">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1seye9j">
          <text>"collection"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1bshbz8">
        <inputEntry id="UnaryTests_1wt5weo">
