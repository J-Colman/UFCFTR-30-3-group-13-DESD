  "id": "form-choose-delivery-option",
  "components": [
    {
      "label": "Choose Delivery Option",
      "type": "radio",
      "layout": {
        "row": "Row_0kcfiik",
        "columns": null
      },
      "id": "Field_18q5rii",
      "key": "deliveryChoice",
      "validate": {
        "required": true
      },
      "valuesExpression": "=for o in distinct values(flatten(deliveryOptions)) return {label: upper case(substring(o, 1, 1)) + substring(o, 2), value: o}"
